{
  "requests": {
    "observatories": {
      "method": "GET",
      "endpoint": "/observatories"
    },
    "sensors": {
      "method": "GET",
      "endpoint": "/sensors"
    },
    "latest_observation": {
      "method": "GET",
      "endpoint": "/packets/latest_observation"
    },
    "daily_min_voltage": {
      "method": "GET",
      "endpoint": "/packets/daily-min-voltage"
    },
    "no_packet_days": {
      "method": "GET",
      "endpoint": "/packets/no-packet-days"
    },
    "active_tickets": {
      "method": "GET",
      "endpoint": "/tickets/active"
    },
    "report": {
      "method": "GET",
      "endpoint": "/reports/:variable/:observatoryId",
      "query": ["bdt", "edt"]
    },
    "battery-report": {
      "method": "GET",
      "endpoint": "/reports/battery/:observatoryId/:years"
    },
    "login": {
      "method": "POST",
      "endpoint": "/login",
      "body": ["email", "password"]
    },
    "forgot_password": {
      "method": "POST",
      "endpoint": "/forgot-password",
      "body": ["email"]
    },
    "reset_password": {
      "method": "POST",
      "endpoint": "/reset-password",
      "body": ["email", "code", "password"]
    },
    "create_ticket": {
      "method": "POST",
      "endpoint": "/tickets"
    },
    "edit_ticket": {
      "method": "PUT",
      "endpoint": "/tickets/:id"
    }
  }
}